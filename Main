import java.time.LocalDate;
import java.time.temporal.ChronoUnit;
import java.util.ArrayList;
import java.util.Scanner;

class Book {
    int id;
    String title;
    String author;
    boolean reserved;
    LocalDate dueDate;

    Book(int id, String title, String author) {
        this.id = id;
        this.title = title;
        this.author = author;
        this.reserved = false;
        this.dueDate = null;
    }
}

public class CentralLibrary {

    static ArrayList<Book> books = new ArrayList<>();
    static Scanner sc = new Scanner(System.in);
    static final double FINE_PER_DAY = 5.0;

    static void addBook() {
        System.out.print("Enter Book ID: ");
        int id = sc.nextInt();
        sc.nextLine();

        for (Book b : books) {
            if (b.id == id) {
                System.out.println("Book ID already exists.");
                return;
            }
        }

        System.out.print("Enter Book Title: ");
        String title = sc.nextLine();

        System.out.print("Enter Author Name: ");
        String author = sc.nextLine();

        books.add(new Book(id, title, author));
        System.out.println("Book added successfully.");
    }

    static void displayBooks() {
        if (books.isEmpty()) {
            System.out.println("No books available.");
            return;
        }

        System.out.println("\n--- Book List ---");

        for (Book b : books) {
            System.out.println("ID: " + b.id);
            System.out.println("Title: " + b.title);
            System.out.println("Author: " + b.author);
            System.out.println("Status: "
                    + (b.reserved ? "Reserved" : "Available"));
            System.out.println("----------------------");
        }
    }

    static Book findBook(int id) {
        for (Book b : books) {
            if (b.id == id) {
                return b;
            }
        }
        return null;
    }

    static void reserveBook() {
        System.out.print("Enter Book ID to reserve: ");
        int id = sc.nextInt();

        Book b = findBook(id);

        if (b == null) {
            System.out.println("Book not found.");
        } else if (b.reserved) {
            System.out.println("Book is already reserved.");
        } else {
            b.reserved = true;
            b.dueDate = LocalDate.now().plusDays(14);
            System.out.println("Book reserved successfully.");
            System.out.println("Due Date: " + b.dueDate);
        }
    }

    static void returnBook() {
        System.out.print("Enter Book ID to return: ");
        int id = sc.nextInt();

        Book b = findBook(id);

        if (b == null) {
            System.out.println("Book not found.");
            return;
        }

        if (!b.reserved) {
            System.out.println("Book is not currently reserved or issued.");
            return;
        }

        LocalDate returnDate = LocalDate.now();

        long overdueDays = Math.max(
                0,
                ChronoUnit.DAYS.between(b.dueDate, returnDate)
        );

        double fine = overdueDays * FINE_PER_DAY;

        System.out.println("Due Date: " + b.dueDate);
        System.out.println("Return Date: " + returnDate);
        System.out.println("Overdue Days: " + overdueDays);
        System.out.println("Fine Amount: Rs. " + fine);

        b.reserved = false;
        b.dueDate = null;

        System.out.println("Book returned successfully.");
    }

    static void calculateFine() {
        System.out.print("Enter Due Date (yyyy-mm-dd): ");
        String dueInput = sc.next();

        System.out.print("Enter Return Date (yyyy-mm-dd): ");
        String returnInput = sc.next();

        try {
            LocalDate dueDate = LocalDate.parse(dueInput);
            LocalDate returnDate = LocalDate.parse(returnInput);

            long overdueDays = Math.max(
                    0,
                    ChronoUnit.DAYS.between(dueDate, returnDate)
            );

            double fine = overdueDays * FINE_PER_DAY;

            System.out.println("Overdue Days: " + overdueDays);
            System.out.println("Fine Amount: Rs. " + fine);

        } catch (Exception e) {
            System.out.println("Invalid date format.");
        }
    }

    public static void main(String[] args) {
        int choice;

        do {
            System.out.println("\n===== CENTRAL LIBRARY SYSTEM =====");
            System.out.println("1. Add Book");
            System.out.println("2. Display Books");
            System.out.println("3. Reserve Book");
            System.out.println("4. Return Book");
            System.out.println("5. Calculate Overdue Fine");
            System.out.println("6. Exit");
            System.out.print("Enter your choice: ");

            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    addBook();
                    break;

                case 2:
                    displayBooks();
                    break;

                case 3:
                    reserveBook();
                    break;

                case 4:
                    returnBook();
                    break;

                case 5:
                    calculateFine();
                    break;

                case 6:
                    System.out.println("Exiting system.");
                    break;

                default:
                    System.out.println("Invalid choice.");
            }

        } while (choice != 6);

        sc.close();
    }
}
